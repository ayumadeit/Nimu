{
  "name": "nimu-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@nimu/web",
    "dev:api": "npm run dev --workspace=@nimu/api",
    "build:shared": "npm run build --workspace=@nimu/shared",
    "build:api": "npm run build --workspace=@nimu/api",
    "build:web": "npm run build --workspace=@nimu/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
