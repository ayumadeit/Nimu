# Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://nimu:nimupassword@localhost:5432/nimu_dev?schema=public"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="nimu_access_secret_super_secure_key_at_least_32_chars_long"
JWT_REFRESH_SECRET="nimu_refresh_secret_super_secure_key_at_least_32_chars_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# S3 / MinIO Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="nimu-assets"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_FORCE_PATH_STYLE=true

# Google OAuth (Optional)
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
